rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isPdf() {
      return request.resource.contentType == 'application/pdf';
    }
    
    function isUnderMaxSize(maxMegabytes) {
      return request.resource.size <= maxMegabytes * 1024 * 1024;
    }

    // House Point Claim Certificates (Images & PDFs up to 10MB)
    match /house_claims/{house}/{fileName=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isImage() || isPdf()) && isUnderMaxSize(10);
    }
    
    // Legacy Claims path (for backward compatibility during migration)
    match /claims/{fileName=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isImage() || isPdf()) && isUnderMaxSize(10);
    }

    // Student and Staff Profile Photos (Images only, strict owner UID matching, up to 5MB)
    match /profile_pictures/{userId}/{fileName=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isImage() && isUnderMaxSize(5);
    }

    match /profile_pictures/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isImage() && isUnderMaxSize(5);
    }

    // Exam Schedules & Academic Resources (Images & PDFs up to 15MB)
    match /exam_schedules/{fileName=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isImage() || isPdf()) && isUnderMaxSize(15);
    }

    // Explicit Default Deny for all other write paths (wildcard write removed for security)
    match /{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
