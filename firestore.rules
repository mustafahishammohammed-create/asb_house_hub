rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// 1. users/{userId}
//    - uid: string (optional, matching userId)
//    - scholar_no: string (4-20 chars) - unique school scholar identifier
//    - full_name: string (2-100 chars)
//    - role: string ('student', 'prefect', 'captain', 'vice_captain',
//            'house_captain', 'house_vice_captain', 'council', 'sports_captain',
//            'sports_vice_captain', 'sports_lead', 'teacher', 'faculty',
//            'principal', 'staff', 'admin', 'super_admin')
//    - house_name: string ('ruby', 'sapphire', 'emerald', 'topaz')
//    - class_level: string (optional, <= 50 chars)
//    - division: string (optional, <= 10 chars)
//    - class_id: string (optional, <= 10 chars; canonical e.g. '11D', 'LKG-A'; owner-immutable)
//    - class_verified: bool (optional; admin-only after signup, defaults false)
//    - points: int (optional, 0-1,000,000)
//    - points_contributed: int (optional, -100,000 to 1,000,000)
//    - age: int (optional, 4-25)
//    - position_title: string (optional, <= 100 chars)
//    - designation: string (optional, <= 100 chars)
//    - created_at: timestamp (optional)
//    - updated_at: timestamp (optional)
//
// 2. users/{userId}/notifications/{notificationId}
//    - title: string (1-100 chars)
//    - body: string (1-500 chars)
//    - timestamp: timestamp
//    - is_read: bool (optional; absent means unread)
//    - type: string (optional, <= 50 chars)
//    - room_id: string (optional, <= 128 chars)
//    - category: string (optional; timetable|house|class|chat|points|system)
//    - priority: string (optional; normal|high|urgent)
//    - dedupe_key: string (optional, 1-200 chars)
//    - source_id: string (optional, <= 128 chars)
//
// 3. admin_roster/{docId}
//    - slot_id: string (optional, <= 64 chars)
//    - scholar_no: string (4-20 chars)
//    - role: string (<= 50 chars)
//    - title: string (optional, <= 100 chars)
//    - name: string (optional, <= 100 chars)
//    - house: string (optional, <= 30 chars)
//    - class: string (optional, <= 30 chars)
//    - assigned_at: timestamp (optional)
//    - updated_at: timestamp (optional)
//
// 4. classes/{classId}
//    - Subcollection timetable/{periodId}: day, period_number, subject, teacher_name, room
//    - Subcollection assignments/{assignmentId}: title, subject, class_level, due_date, description
//    - Subcollection midterm_exams/{examId}: subject, date, portion, room
//    - Subcollection report_cards/{reportCardId}: term, grades, scholar_no
//    - Subcollection attendance/{scholarNo}/records/{recordId}: date, status, periods
//
// 5. homework/{assignmentId}
//    - id: string (optional, <= 64 chars)
//    - title: string (1-150 chars)
//    - subject: string (1-80 chars)
//    - class_level: string (optional, <= 50 chars)
//    - division: string (optional, <= 10 chars)
//    - assigned_date: string or timestamp (optional)
//    - due_date: string or timestamp (optional)
//    - description: string (optional, <= 3000 chars)
//    - teacher_name: string (optional, <= 100 chars)
//    - max_marks: number (optional, 0-1000)
//    - attachments: list (optional, <= 10 items)
//    - created_at: timestamp (optional)
//
// 6. house_claims/{claimId}
//    - scholar_no: string (4-20 chars)
//    - student_name: string (2-100 chars)
//    - house_name: string ('ruby', 'sapphire', 'emerald', 'topaz')
//    - activity_title: string (2-150 chars)
//    - points: int (1-500)
//    - cert_url: string (URL or Base64 data URI, 5-500,000 chars)
//    - status: string ('pending', 'approved', 'rejected')
//    - auto_validated: bool (optional)
//    - ocr_keywords: list (optional, <= 30 items)
//    - created_at: timestamp (optional)
//    - verified_at: timestamp (optional)
//    - rejection_reason: string (optional, <= 500 chars)
//
// 7. orders/{orderId}
//    - receipt_id: string (4-64 chars)
//    - scholar_no: string (optional, <= 20 chars)
//    - student_name: string (optional, <= 100 chars)
//    - user_id: string (optional, <= 128 chars)
//    - house: string (optional, <= 30 chars)
//    - items: list (1-50 items)
//    - total_price / total_pts / total_bhd: number (optional, >= 0)
//    - currency: string (optional, <= 10 chars)
//    - status: string ('placed', 'pending', 'claimed', 'verified')
//    - created_at: timestamp (optional)
//    - claimed_at: timestamp (optional)
//    - claimed_by: string (optional, <= 100 chars)
//
// 8. fixtures/{fixtureId} and sports_fixtures/{fixtureId}
//    - fixture_id: string (optional)
//    - sport_type: string (<= 50 chars)
//    - house_a / house_b: string
//    - score_a / score_b: int (0-999)
//    - status: string ('upcoming', 'live', 'completed', 'scheduled', 'cancelled', 'postponed')
//    - venue: string (optional, <= 100 chars)
//    - referee_scholar_no: string (optional, <= 20 chars)
//    - certification_token: string (optional, <= 256 chars)
//
// 9. elections/{electionId}
//    - title: string (1-150 chars)
//    - position: string (1-100 chars)
//    - candidates: list (<= 50 items)
//    - total_votes_cast: int (>= 0)
//    - is_open: bool
//    - Subcollection ballots/{ballotId}: ballot_id, candidate_scholar_no, timestamp (1 per user)
//
// 10. election_votes/{voteId}
//     - ballot_id: string
//     - voter_hash: string
//     - proof_token: string
//     - timestamp: timestamp
//
// 11. announcements/{announcementId}, notices/{noticeId}, events/{eventId}
//     - title: string (1-200 chars)
//     - body / content: string (optional, <= 5000 chars)
//     - author_name: string (optional, <= 100 chars)
//     - priority: string (optional)
//
// 12. chats/{channelId} and chats/{channelId}/messages/{messageId}
//     - Room doc: participants, participant_names, participant_roles, last_message, last_updated
//     - Message doc: sender_id, sender_name, text (1-2000 chars), timestamp, is_read
//
// 13. attendance/{recordId}
//     - scholar_no: string (4-20 chars)
//     - status: string ('present', 'absent', 'late', 'excused', 'holiday')
//     - date: timestamp or string
//     - excused_reason: string (optional, <= 500 chars)
//
// 14. sports_trophies/{trophyId}
//     - title: string (1-150 chars)
//     - sport: string (<= 50 chars)
//     - winning_house: string
//     - points_value: int (0-5000)
//
// 15. system_config/house_spirit_reactor
//     - ruby, sapphire, emerald, topaz: number (>= 0)
//     - last_contributor: string (optional, <= 100 chars)
//     - last_updated: timestamp (optional)
//
// 16. settings/ticker
//     - message: string (optional, <= 500 chars)
//     - active: bool (optional)
//     - updated_at: timestamp (optional)
//
// 17. event_wall/{postId}
//     - scholar_no: string (4-20 chars)
//     - student_name: string (2-100 chars)
//     - house_name: string ('ruby', 'sapphire', 'emerald', 'topaz')
//     - class_level: string (optional, <= 50 chars)
//     - caption: string (optional, <= 500 chars)
//     - image_url: string (URL or Base64 data URI, 5-500,000 chars)
//     - timestamp: timestamp (optional)
//     - status: string ('pending', 'approved', 'rejected')
//     - likes: int (optional, >= 0)
//     - liked_by: list (optional, <= 5000 items)
//
// 18. player_sports_stats/{statsId}
//     - scholar_no: string (4-20 chars)
//     - student_name: string (2-100 chars)
//     - house_name: string ('ruby', 'sapphire', 'emerald', 'topaz')
//     - sport_type: string (<= 50 chars)
//     - goals_scored / baskets_scored / aces_scored / track_points: int (optional, >= 0)
//     - mvp_awards_count / matches_played: int (optional, >= 0)
//     - updated_at: timestamp (optional)
//
// 19. school_members/{memberId}
//     - scholar_no: string (4-64 chars) - verified school roster identifier
//     - display_name: string (<= 120 chars)
//     - role: string ('student', 'teacher', 'admin', etc.)
//     - grade: int (optional, 1-12)
//     - house: string ('ruby', 'sapphire', 'emerald', 'topaz')
//     - active: bool
//     - capabilities: map (optional, e.g. manage_elections: bool)
//
// 20. election_polls_v2/{pollId}
//     - title: string (<= 120 chars)
//     - position: string
//     - minGrade: int (1-12)
//     - maxGrade: int (1-12)
//     - house: string ('all', 'ruby', 'sapphire', 'emerald', 'topaz')
//     - opensAt: timestamp
//     - closesAt: timestamp
//     - candidates: list of candidate maps [{id, name, statement}]
//     - status: string ('published', 'certified')
//     - publishedAt: timestamp (optional)
//     - result: map (optional, rows, total, leaders, outcome)
//     - certifiedAt: timestamp (optional)
//     - Subcollection counts/{candidateId}: count: int
//     - Subcollection participation/{key}: receipt: string
//
// 21. election_drafts_v2/{draftId}
//     - title: string (<= 120 chars)
//     - position: string
//     - minGrade: int (1-12)
//     - maxGrade: int (1-12)
//     - house: string ('all', 'ruby', 'sapphire', 'emerald', 'topaz')
//     - startMs: int
//     - endMs: int
//     - candidates: list of candidate maps [{id, uid, name, statement}]
//     - status: string ('draft', 'published', 'certified')
//     - createdBy: string (uid)
//     - publishedBy: string (optional, uid)
//     - certifiedBy: string (optional, uid)
//
// 22. academic_classes/{classId} (M1 canonical class/section registry)
//     - class_id: string (2-10 chars, must equal document id; e.g. '11D', 'LKG-A')
//     - grade: string ('LKG', 'UKG', 'Grade 1'..'Grade 12')
//     - section: string (1-3 chars)
//     - active: bool
//     - class_teacher: string (optional, <= 100 chars)
//     - academic_year: string (optional, <= 20 chars)
//     - created_at / updated_at: timestamp (optional)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Global Helper Functions
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Role-Based Access Control
    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token != null && (
          ('admin' in request.auth.token && request.auth.token.admin == true) ||
          ('role' in request.auth.token && request.auth.token.role in ['super_admin', 'admin']) ||
          ('email' in request.auth.token && (
            request.auth.token.email in ['admin@asianschool.bh', '11209@asianschool.bh'] ||
            request.auth.token.email.matches('(?i)^admin@.*') ||
            request.auth.token.email.matches('(?i)^11209@.*')
          ))
        )) ||
        exists(/databases/$(database)/documents/admin_roster/$(request.auth.uid)) ||
        (hasUserDoc() && 'role' in getUserData() && getUserData().role in ['super_admin', 'admin']) ||
        (exists(/databases/$(database)/documents/school_members/$(request.auth.uid)) &&
         'role' in get(/databases/$(database)/documents/school_members/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/school_members/$(request.auth.uid)).data.role in ['super_admin', 'admin'])
      );
    }

    function isSeniorAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        (request.auth.token != null && 'role' in request.auth.token && request.auth.token.role in ['principal', 'super_admin', 'admin', 'administrator']) ||
        (hasUserDoc() && 'role' in getUserData() && getUserData().role in ['principal', 'super_admin', 'admin', 'administrator'])
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        (request.auth.token != null && 'role' in request.auth.token && request.auth.token.role in ['teacher', 'faculty', 'principal', 'staff', 'faculty_advisor', 'teacher_lead', 'class_teacher', 'subject_teacher']) ||
        (hasUserDoc() && 'role' in getUserData() && getUserData().role in ['teacher', 'faculty', 'principal', 'staff', 'faculty_advisor', 'teacher_lead', 'class_teacher', 'subject_teacher'])
      );
    }

    function getClassData(classId) {
      return get(/databases/$(database)/documents/academic_classes/$(classId)).data;
    }

    function isTimetableEditor(classId) {
      return isSeniorAdmin() || (
        isAdmin() &&
        exists(/databases/$(database)/documents/academic_classes/$(classId)) &&
        (!('timetable_editing_enabled' in getClassData(classId)) || getClassData(classId).timetable_editing_enabled == true) &&
        (
          ('class_teacher_uid' in getClassData(classId) && getClassData(classId).class_teacher_uid == request.auth.uid) ||
          ('timetable_editor_uids' in getClassData(classId) && request.auth.uid in getClassData(classId).timetable_editor_uids)
        )
      );
    }

    function canPublishTimetable(classId) {
      return isSeniorAdmin() || (
        isTimetableEditor(classId) &&
        exists(/databases/$(database)/documents/academic_classes/$(classId)) &&
        (!('timetable_requires_approval' in getClassData(classId)) || getClassData(classId).timetable_requires_approval != true)
      );
    }

    function isCaptain() {
      return isSignedIn() && (
        (request.auth.token != null && 'role' in request.auth.token && request.auth.token.role in [
          'captain', 'vice_captain', 'house_captain', 'house_vice_captain'
        ]) ||
        (hasUserDoc() && 'role' in getUserData() && getUserData().role in [
          'captain', 'vice_captain', 'house_captain', 'house_vice_captain'
        ])
      );
    }

    function isCouncil() {
      return isSignedIn() && (
        (request.auth.token != null && 'role' in request.auth.token && request.auth.token.role in [
          'council', 'head_boy', 'head_girl', 'deputy_head_boy', 'deputy_head_girl',
          'head_of_activities', 'cultural_secretary', 'sports_captain', 'sports_vice_captain', 'executive_council'
        ]) ||
        (hasUserDoc() && 'role' in getUserData() && getUserData().role in [
          'council', 'head_boy', 'head_girl', 'deputy_head_boy', 'deputy_head_girl',
          'head_of_activities', 'cultural_secretary', 'sports_captain', 'sports_vice_captain', 'executive_council'
        ])
      );
    }

    function isPrefect() {
      return isSignedIn() && (
        (request.auth.token != null && 'role' in request.auth.token && request.auth.token.role in [
          'prefect', 'student_rep', 'grade_prefect'
        ]) ||
        (hasUserDoc() && 'role' in getUserData() && getUserData().role in [
          'prefect', 'student_rep', 'grade_prefect'
        ])
      );
    }

    function isSportsLead() {
      return isSignedIn() && (
        isAdmin() ||
        (request.auth.token != null && 'role' in request.auth.token && request.auth.token.role in ['sports_captain', 'sports_vice_captain', 'sports_lead']) ||
        (hasUserDoc() && 'role' in getUserData() && getUserData().role in ['sports_captain', 'sports_vice_captain', 'sports_lead'])
      );
    }

    // House group membership is derived from the verified profile, never a
    // self-asserted join document. A house transfer therefore revokes the old
    // group and grants the new one atomically at the profile level.
    function isSameHouse(houseId) {
      return isSignedIn() && hasUserDoc() &&
        'house_name' in getUserData() &&
        getUserData().house_name is string &&
        getUserData().house_name.lower() == houseId.lower();
    }

    // Authorised senders: house captains/vice-captains, council officers
    // (sports captains, head boy/girl, etc.), and staff/faculty.
    // Regular students and prefects remain read-only.
    function isHouseSender(houseId) {
      return isSameHouse(houseId) && (isAdmin() || isCaptain() || isCouncil());
    }

    function isHouseModerator(houseId) {
      return isSeniorAdmin() || isHouseSender(houseId);
    }

    // Class-group membership is derived from the verified class placement on
    // the profile. Unverified signups and legacy profiles without
    // class_verified == true are not members.
    function isVerifiedClassMember(classId) {
      return isSignedIn() && hasUserDoc() &&
        'class_id' in getUserData() &&
        getUserData().class_id is string &&
        getUserData().class_id.upper() == classId.upper() &&
        'class_verified' in getUserData() &&
        getUserData().class_verified == true;
    }

    function isClassTeacher(classId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/academic_classes/$(classId)) &&
        'class_teacher_uid' in getClassData(classId) &&
        getClassData(classId).class_teacher_uid == request.auth.uid;
    }

    // Subject teachers can only post to classes where an administrator has
    // listed their UID in academic_classes/{classId}.subject_teacher_uids.
    function isClassSubjectTeacher(classId) {
      return isAdmin() &&
        exists(/databases/$(database)/documents/academic_classes/$(classId)) &&
        'subject_teacher_uids' in getClassData(classId) &&
        request.auth.uid in getClassData(classId).subject_teacher_uids;
    }

    function isClassRepresentative(classId) {
      return isVerifiedClassMember(classId) && hasUserDoc() &&
        'role' in getUserData() &&
        getUserData().role in ['class_representative', 'vice_class_representative'];
    }

    function isClassStudentSender(classId) {
      return isVerifiedClassMember(classId) && hasUserDoc() &&
        'role' in getUserData() &&
        getUserData().role in ['student', 'prefect'] &&
        exists(/databases/$(database)/documents/academic_classes/$(classId)) &&
        'student_posting_enabled' in getClassData(classId) &&
        getClassData(classId).student_posting_enabled == true;
    }

    function isClassSender(classId) {
      return isClassTeacher(classId) ||
        isClassSubjectTeacher(classId) ||
        isClassRepresentative(classId) ||
        isClassStudentSender(classId);
    }

    function isClassModerator(classId) {
      return isSeniorAdmin() || isClassTeacher(classId);
    }

    function isClassViewer(classId) {
      return isVerifiedClassMember(classId) ||
        isClassTeacher(classId) ||
        isClassSubjectTeacher(classId) ||
        isClassRepresentative(classId) ||
        isSeniorAdmin();
    }

    // Resolves student identity against current authenticated user (via email prefix or users profile)
    function isScholarOwner(scholarNo) {
      return isSignedIn() && (
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email is string && request.auth.token.email.matches('^' + scholarNo + '@.*')) ||
        (hasUserDoc() && 'scholar_no' in getUserData() && getUserData().scholar_no == scholarNo)
      );
    }

    // Generic schema validation helpers
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return hasOnlyAllowedFields([
        'uid', 'scholar_no', 'full_name', 'role', 'house_name',
        'class_level', 'division', 'class_id', 'class_verified',
        'points', 'points_contributed',
        'created_at', 'updated_at', 'age', 'position_title', 'designation',
        'status'
      ]) &&
      hasRequiredFields(['scholar_no', 'full_name', 'role', 'house_name']) &&
      data.full_name is string && data.full_name.size() >= 2 && data.full_name.size() <= 100 &&
      data.scholar_no is string && data.scholar_no.size() >= 4 && data.scholar_no.size() <= 20 &&
      !(data.scholar_no in ['admin', '11209']) &&
      !(data.scholar_no.lower() in ['admin', '11209']) &&
      data.role is string && data.role in [
        'student', 'prefect', 'captain', 'vice_captain',
        'house_captain', 'house_vice_captain', 'council',
        'sports_captain', 'sports_vice_captain', 'sports_lead',
        'head_boy', 'head_girl', 'deputy_head_boy', 'deputy_head_girl',
        'head_of_activities', 'cultural_secretary', 'executive_council',
        'class_representative', 'vice_class_representative', 'parent',
        'teacher', 'faculty', 'faculty_advisor', 'teacher_lead',
        'class_teacher', 'subject_teacher',
        'principal', 'staff', 'administrator', 'admin', 'super_admin'
      ] &&
      data.house_name is string && data.house_name.lower() in ['ruby', 'sapphire', 'emerald', 'topaz'] &&
      (!('class_level' in data) || (data.class_level is string && data.class_level.size() <= 50)) &&
      (!('division' in data) || (data.division is string && data.division.size() <= 10)) &&
      (!('class_id' in data) || (data.class_id is string && data.class_id.size() <= 10)) &&
      (!('class_verified' in data) || data.class_verified is bool) &&
      (!('points' in data) || (data.points is int && data.points >= 0 && data.points <= 1000000)) &&
      (!('points_contributed' in data) || (data.points_contributed is int && data.points_contributed >= -100000 && data.points_contributed <= 1000000)) &&
      (!('age' in data) || (data.age is int && data.age >= 4 && data.age <= 25)) &&
      (!('position_title' in data) || (data.position_title is string && data.position_title.size() <= 100)) &&
      (!('designation' in data) || (data.designation is string && data.designation.size() <= 100)) &&
      (!('uid' in data) || (data.uid is string && data.uid.size() <= 128)) &&
      (!('status' in data) || (data.status is string && data.status in ['active', 'suspended', 'deactivated'])) &&
      (!('created_at' in data) || data.created_at is timestamp) &&
      (!('updated_at' in data) || data.updated_at is timestamp);
    }

    function isValidNotification(data) {
      return hasOnlyAllowedFields([
          'title', 'body', 'timestamp', 'is_read', 'type', 'room_id',
          'category', 'priority', 'dedupe_key', 'source_id'
        ]) &&
        hasRequiredFields(['title', 'body', 'timestamp']) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 500 &&
        (!('is_read' in data) || data.is_read is bool) &&
        data.timestamp is timestamp &&
        (!('type' in data) || (data.type is string && data.type.size() <= 50)) &&
        (!('room_id' in data) || (data.room_id is string && data.room_id.size() <= 128)) &&
        (!('category' in data) || (
          data.category is string &&
          data.category in ['timetable', 'house', 'class', 'chat', 'points', 'system']
        )) &&
        (!('priority' in data) || (
          data.priority is string &&
          data.priority in ['normal', 'high', 'urgent']
        )) &&
        (!('dedupe_key' in data) || (
          data.dedupe_key is string &&
          data.dedupe_key.size() >= 1 &&
          data.dedupe_key.size() <= 200
        )) &&
        (!('source_id' in data) || (
          data.source_id is string && data.source_id.size() <= 128
        ));
    }

    function isValidAcademicClass(data) {
      return hasOnlyAllowedFields([
        'class_id', 'grade', 'section', 'active', 'class_teacher',
        'class_teacher_uid', 'subject_teacher_uids', 'student_posting_enabled',
        'timetable_editor_uids', 'timetable_editing_enabled', 'timetable_requires_approval',
        'academic_year', 'created_at', 'updated_at'
      ]) &&
      hasRequiredFields(['class_id', 'grade', 'section', 'active']) &&
      data.class_id is string && data.class_id.size() >= 2 && data.class_id.size() <= 10 &&
      data.grade is string && data.grade in [
        'LKG', 'UKG', 'Grade 1', 'Grade 2', 'Grade 3', 'Grade 4', 'Grade 5',
        'Grade 6', 'Grade 7', 'Grade 8', 'Grade 9', 'Grade 10', 'Grade 11', 'Grade 12'
      ] &&
      data.section is string && data.section.size() >= 1 && data.section.size() <= 3 &&
      data.active is bool &&
      (!('class_teacher' in data) || (data.class_teacher is string && data.class_teacher.size() <= 100)) &&
      (!('class_teacher_uid' in data) || (data.class_teacher_uid is string && data.class_teacher_uid.size() <= 128)) &&
      (!('subject_teacher_uids' in data) || (data.subject_teacher_uids is list && data.subject_teacher_uids.size() <= 30)) &&
      (!('student_posting_enabled' in data) || data.student_posting_enabled is bool) &&
      (!('timetable_editor_uids' in data) || (data.timetable_editor_uids is list && data.timetable_editor_uids.size() <= 20)) &&
      (!('timetable_editing_enabled' in data) || data.timetable_editing_enabled is bool) &&
      (!('timetable_requires_approval' in data) || data.timetable_requires_approval is bool) &&
      (!('academic_year' in data) || (data.academic_year is string && data.academic_year.size() <= 20)) &&
      (!('created_at' in data) || data.created_at is timestamp) &&
      (!('updated_at' in data) || data.updated_at is timestamp);
    }

    function isValidTimetableSlot(slot) {
      return slot is map &&
        slot.keys().hasOnly(['period_number', 'subject', 'teacher_name', 'teacher_uid', 'room', 'start_minute', 'image_url', 'notes', 'substitute_teacher_name', 'substitute_teacher_uid']) &&
        slot.period_number is int && slot.period_number >= 1 && slot.period_number <= 8 &&
        slot.start_minute is int && slot.start_minute >= 0 && slot.start_minute < 1440 &&
        (!('subject' in slot) || (slot.subject is string && slot.subject.size() <= 80)) &&
        (!('teacher_name' in slot) || (slot.teacher_name is string && slot.teacher_name.size() <= 100)) &&
        (!('teacher_uid' in slot) || (slot.teacher_uid is string && slot.teacher_uid.size() <= 128)) &&
        (!('room' in slot) || (slot.room is string && slot.room.size() <= 50)) &&
        (!('image_url' in slot) || (slot.image_url is string && slot.image_url.size() <= 500000)) &&
        (!('notes' in slot) || (slot.notes is string && slot.notes.size() <= 500)) &&
        (!('substitute_teacher_name' in slot) || (slot.substitute_teacher_name is string && slot.substitute_teacher_name.size() <= 100)) &&
        (!('substitute_teacher_uid' in slot) || (slot.substitute_teacher_uid is string && slot.substitute_teacher_uid.size() <= 128));
    }

    // Periods must be exactly 1..8 in order and must not overlap. Gaps are
    // allowed (M3 transition gaps), but starts must be strictly increasing by
    // at least the fixed 45-minute teaching duration. The last period must end
    // by midnight.
    function hasOrderedTimetableSlots(slots) {
      return slots[0].period_number == 1 &&
        slots[1].period_number == 2 &&
        slots[2].period_number == 3 &&
        slots[3].period_number == 4 &&
        slots[4].period_number == 5 &&
        slots[5].period_number == 6 &&
        slots[6].period_number == 7 &&
        slots[7].period_number == 8 &&
        slots[0].start_minute + 45 <= slots[1].start_minute &&
        slots[1].start_minute + 45 <= slots[2].start_minute &&
        slots[2].start_minute + 45 <= slots[3].start_minute &&
        slots[3].start_minute + 45 <= slots[4].start_minute &&
        slots[4].start_minute + 45 <= slots[5].start_minute &&
        slots[5].start_minute + 45 <= slots[6].start_minute &&
        slots[6].start_minute + 45 <= slots[7].start_minute &&
        slots[7].start_minute + 45 <= 1440;
    }

    // The 30-minute break must sit between the period it follows and the next
    // period, and must end by midnight. break_after_period 1..8 selects the
    // only slot pair that is checked.
    function isValidTimetableBreakPlacement(slots, breakAfterPeriod, breakStartMinute) {
      return breakStartMinute + 30 <= 1440 &&
        (breakAfterPeriod != 1 || (slots[0].start_minute + 45 <= breakStartMinute && breakStartMinute + 30 <= slots[1].start_minute)) &&
        (breakAfterPeriod != 2 || (slots[1].start_minute + 45 <= breakStartMinute && breakStartMinute + 30 <= slots[2].start_minute)) &&
        (breakAfterPeriod != 3 || (slots[2].start_minute + 45 <= breakStartMinute && breakStartMinute + 30 <= slots[3].start_minute)) &&
        (breakAfterPeriod != 4 || (slots[3].start_minute + 45 <= breakStartMinute && breakStartMinute + 30 <= slots[4].start_minute)) &&
        (breakAfterPeriod != 5 || (slots[4].start_minute + 45 <= breakStartMinute && breakStartMinute + 30 <= slots[5].start_minute)) &&
        (breakAfterPeriod != 6 || (slots[5].start_minute + 45 <= breakStartMinute && breakStartMinute + 30 <= slots[6].start_minute)) &&
        (breakAfterPeriod != 7 || (slots[6].start_minute + 45 <= breakStartMinute && breakStartMinute + 30 <= slots[7].start_minute)) &&
        (breakAfterPeriod != 8 || (slots[7].start_minute + 45 <= breakStartMinute));
    }

    function isValidTimetableVersion(data, classId) {
      return hasOnlyAllowedFields([
        'id', 'class_id', 'day_of_week', 'status', 'effective_from', 'version',
        'break_after_period', 'break_start_minute', 'slots',
        'created_by_uid', 'created_by_name', 'published_at',
        'approved_by_uid', 'approved_by_name', 'supersedes_id',
        'rejection_reason', 'created_at', 'updated_at', 'override_date'
      ]) &&
      hasRequiredFields(['class_id', 'day_of_week', 'status', 'effective_from', 'version', 'break_after_period', 'break_start_minute', 'slots']) &&
      data.class_id is string && data.class_id == classId &&
      data.day_of_week is string && data.day_of_week in ['Saturday', 'Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday'] &&
      data.status is string && data.status in ['draft', 'submitted', 'published', 'rejected'] &&
      data.effective_from is timestamp &&
      data.version is int && data.version >= 1 && data.version <= 10000 &&
      data.break_after_period is int && data.break_after_period >= 1 && data.break_after_period <= 8 &&
      data.break_start_minute is int && data.break_start_minute >= 0 && data.break_start_minute < 1440 &&
      data.slots is list && data.slots.size() == 8 &&
      isValidTimetableSlot(data.slots[0]) &&
      isValidTimetableSlot(data.slots[1]) &&
      isValidTimetableSlot(data.slots[2]) &&
      isValidTimetableSlot(data.slots[3]) &&
      isValidTimetableSlot(data.slots[4]) &&
      isValidTimetableSlot(data.slots[5]) &&
      isValidTimetableSlot(data.slots[6]) &&
      isValidTimetableSlot(data.slots[7]) &&
      hasOrderedTimetableSlots(data.slots) &&
      isValidTimetableBreakPlacement(data.slots, data.break_after_period, data.break_start_minute) &&
      (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
      (!('created_by_uid' in data) || (data.created_by_uid is string && data.created_by_uid.size() <= 128)) &&
      (!('created_by_name' in data) || (data.created_by_name is string && data.created_by_name.size() <= 100)) &&
      (!('approved_by_uid' in data) || (data.approved_by_uid is string && data.approved_by_uid.size() <= 128)) &&
      (!('approved_by_name' in data) || (data.approved_by_name is string && data.approved_by_name.size() <= 100)) &&
      (!('supersedes_id' in data) || (data.supersedes_id is string && data.supersedes_id.size() <= 128)) &&
      (!('rejection_reason' in data) || (data.rejection_reason is string && data.rejection_reason.size() <= 500)) &&
      (!('override_date' in data) || data.override_date is timestamp) &&
      (!('published_at' in data) || data.published_at is timestamp) &&
      (!('created_at' in data) || data.created_at is timestamp) &&
      (!('updated_at' in data) || data.updated_at is timestamp);
    }

